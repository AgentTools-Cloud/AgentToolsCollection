[Unit]
Description=agent-tools BotsRated quality synchronizer
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mcpserver
EnvironmentFile=/opt/mcpserver/.env
Environment="PYTHONPATH=/opt/mcpserver"
ExecStart=/opt/mcpserver/.venv/bin/python -m directory.jobs sync-botsrated --limit 1000 --stale-hours 24
User=root

# Explicitly reuse the existing backend of this same project's safety review.
# No credentials stored here; quotas/billing are shared with that project key.
AGENT_TOOLS_ASK_USE_SAFETY_BACKEND=1
AGENT_TOOLS_ASK_BASE_URL=https://tianshu-gateway.cloud
# Model ids are set on the server only (/etc/agent-tools/ask.env); not kept in the repo.
AGENT_TOOLS_ASK_MODEL=
AGENT_TOOLS_SAFETY_MODEL=
AGENT_TOOLS_ASK_READ_TIMEOUT=45
AGENT_TOOLS_ASK_MAX_TOKENS=2048
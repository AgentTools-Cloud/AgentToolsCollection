#!/bin/bash
# Restart mcpserver and mcpserver-b one at a time; nginx keeps serving from the other.
set -euo pipefail
wait_healthy() {
    for _ in $(seq 1 120); do
        [ "$(curl -s -o /dev/null -m 3 -w '%{http_code}' "http://127.0.0.1:$1/healthz")" = 200 ] && return 0
        sleep 0.5
    done
    echo "port $1 not healthy after 60s" >&2; return 1
}
# nginx upstream uses max_fails=1 fail_timeout=5s: a request that hit the
# restarting instance marks it down for 5s. Restarting the other instance inside
# that window leaves no live upstream and nginx returns 502, so wait it out;
# 20s also lets the restarted instance warm up before the other one goes down.
SETTLE_SECONDS="${AGENT_TOOLS_RESTART_SETTLE:-20}"
first=1
for pair in "mcpserver-b 9101" "mcpserver 9100"; do
    set -- $pair
    if [ "$first" = 0 ]; then
        sleep "$SETTLE_SECONDS"
    fi
    first=0
    systemctl restart "$1"
    wait_healthy "$2"
    # Each nginx worker keeps its own failure state, and a peer marked down only
    # comes back after a probe request succeeds; a reload starts fresh workers
    # that see both instances live, so the next restart cannot leave none.
    if nginx -t -q 2>/dev/null; then
        systemctl reload nginx
        sleep 1
    else
        echo "nginx -t failed; not reloading" >&2
    fi
    echo "$1 healthy on :$2"
done

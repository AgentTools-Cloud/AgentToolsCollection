[Unit]
Description=agent-tools directory quarantine re-probe (long-down >14d, signal Q)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mcpserver
EnvironmentFile=/opt/mcpserver/.env
Environment="PYTHONPATH=/opt/mcpserver"
ExecStart=/opt/mcpserver/.venv/bin/python -m directory.jobs health-quarantined
User=root

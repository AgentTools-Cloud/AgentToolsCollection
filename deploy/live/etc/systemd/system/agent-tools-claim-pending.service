[Unit]
Description=agent-tools pending claim auto-check (bounded schedule)
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/mcpserver
EnvironmentFile=/opt/mcpserver/.env
Environment="PYTHONPATH=/opt/mcpserver"
# A running Type=oneshot unit is "activating", which is-active reports as not active.
ExecCondition=/bin/sh -c "! systemctl show -p ActiveState --value agent-tools-crawl.service | grep -qxE 'activating|active|deactivating|reloading'"
ExecStart=/opt/mcpserver/.venv/bin/python -m directory.jobs ownership-pending-recheck
TimeoutStartSec=20min
User=root

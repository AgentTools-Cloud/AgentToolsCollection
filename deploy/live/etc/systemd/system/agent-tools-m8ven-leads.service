[Unit]
Description=agent-tools M8ven leads: new listings re-read from GitHub or the endpoint itself
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mcpserver
EnvironmentFile=/opt/mcpserver/.env
# AGENT_TOOLS_M8VEN_LEADS=1 switches it on; 0 there (or disabling the timer) stops it.
EnvironmentFile=-/etc/agent-tools/m8ven-leads.env
Environment="PYTHONPATH=/opt/mcpserver"
# Shares the GitHub search quota with a manual full code crawl: skip while one runs.
ExecCondition=/bin/sh -c '! systemctl show -p ActiveState --value agent-tools-crawl-code-full.service | grep -qxE "activating|active|deactivating|reloading"'
ExecStart=/opt/mcpserver/.venv/bin/python -m directory.jobs m8ven-leads
# Health waits for it in the queue: never hold health longer than this.
TimeoutStartSec=1h
Nice=10
User=root

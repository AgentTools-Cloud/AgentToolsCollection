[Unit]
Description=agent-tools directory auto-review (x402 verify pending submissions)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mcpserver
EnvironmentFile=/opt/mcpserver/.env
Environment="PYTHONPATH=/opt/mcpserver"
ExecStart=/opt/mcpserver/.venv/bin/python -m directory.jobs auto-review
User=root

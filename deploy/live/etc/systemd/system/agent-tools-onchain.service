[Unit]
Description=agent-tools directory on-chain demand probe (signal C)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mcpserver
EnvironmentFile=/opt/mcpserver/.env
Environment="PYTHONPATH=/opt/mcpserver"
ExecStart=/opt/mcpserver/.venv/bin/python -m directory.jobs onchain
User=root

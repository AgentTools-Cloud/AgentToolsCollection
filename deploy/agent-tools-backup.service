[Unit]
Description=Agent Tools encrypted online backup and offsite restore verification
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/mcpserver/ops/backup_agent_tools.py --timeout 600
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
MemoryMax=384M
Environment=PYTHONDONTWRITEBYTECODE=1

[Unit]
Description=agent-tools code-only MCP crawl (GitHub topic:mcp-server + npm keyword mcp-server)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mcpserver
EnvironmentFile=/opt/mcpserver/.env
Environment="PYTHONPATH=/opt/mcpserver"
# GitHub search: ~30 requests/minute with the OAuth App credentials.
# First stage: only GitHub repositories with >=100 stars and the first 1,000 npm
# packages (~1,800 listings). Widen these limits deliberately, not by default.
ExecStart=/opt/mcpserver/.venv/bin/python -m directory.jobs crawl-code --min-stars 100 --npm-limit 1000
TimeoutStartSec=3h
Nice=10
User=root

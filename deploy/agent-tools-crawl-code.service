[Unit]
Description=agent-tools code-only MCP crawl (GitHub topics, package keywords, Registry/Cline/ModelScope/Docker/Baidu)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mcpserver
EnvironmentFile=/opt/mcpserver/.env
Environment="PYTHONPATH=/opt/mcpserver"
# GitHub search: ~30 requests/minute with the OAuth App credentials.
# Incremental: repositories pushed since the last successful run (2-day
# overlap). The first run, or `crawl-code --full`, imports the whole backlog;
# rows are dated by repository / package creation, not by import day.
# Daily ~20 min; Sundays add the Baidu MCP World walk (~1 h); a full run
# with the first backlog of hinted repositories takes several hours.
# Skip the daily run while a manual full run (systemd-run unit
# agent-tools-crawl-code-full) is still going: it shares the GitHub quota and
# memory, and the full run already covers the window.
ExecCondition=/bin/sh -c '! systemctl show -p ActiveState --value agent-tools-crawl-code-full.service | grep -qxE "activating|active|deactivating|reloading"'
ExecStart=/opt/mcpserver/.venv/bin/python -m directory.jobs crawl-code
TimeoutStartSec=8h
Nice=10
User=root

[Unit]
Description=agent-tools directory health probe
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mcpserver
EnvironmentFile=/opt/mcpserver/.env
Environment="PYTHONPATH=/opt/mcpserver"
# The daily crawls are ordered in health.service.d/queue.conf; a manual full code crawl is a transient unit.
ExecStartPre=/usr/bin/timeout 6h /bin/sh -c 'while systemctl show -p ActiveState --value agent-tools-crawl-code-full.service | grep -qxE "activating|active|deactivating|reloading"; do sleep 60; done'
ExecStart=/opt/mcpserver/.venv/bin/python -m directory.jobs health
ExecStartPost=/opt/mcpserver/.venv/bin/python -m directory.jobs retire-stale-tunnels
User=root
